<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <statistic center="1.5 0 0.2" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="ramp_mat" rgba="0.78 0.82 0.88 1"/>
    <material name="stair_mat" rgba="0.70 0.74 0.80 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      경사: 바닥(z≈0)에서 시작, +X로 갈수록 상승 (~10°)
      quat y 음수 → 앞(+X)이 높아짐
      half-length 1.6 → 전체 길이 ≈ 3.15 m, 상승 ≈ 0.55 m
    -->
    <geom name="approach_ramp" type="box"
          size="1.6 1.0 0.025"
          pos="2.2 0 0.28"
          quat="0.9962 0 -0.0872 0"
          material="ramp_mat"
          friction="1.5 0.1 0.02"/>

    <!--
      계단: 경사가 끝나는 높이(~0.55 m)부터 이어짐
      한 단 높이 ≈ 0.05 m (half-extent 0.025)
    -->
    <geom name="stair_1" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="3.95 0 0.575"/>
    <geom name="stair_2" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.20 0 0.625"/>
    <geom name="stair_3" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.45 0 0.675"/>
    <geom name="stair_4" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.70 0 0.725"/>
    <geom name="stair_top" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.35 1.0 0.025" pos="5.10 0 0.775"/>
  </worldbody>
</mujoco>
