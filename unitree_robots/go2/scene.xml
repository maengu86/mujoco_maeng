<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <statistic center="1.8 0 0.2" extent="1.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="ramp_mat" rgba="0.82 0.86 0.90 1"/>
    <material name="stair_mat" rgba="0.70 0.74 0.80 1"/>

    <!--
      heightfield 경사: 왼쪽(-X) elevation=0 → 오른쪽(+X) elevation=0.55
      박스/평판이 아니라 지면에서 부드럽게 올라옴 (앞쪽 두께 턱 없음)
      size = (x반경, y반경, 최대높이, 베이스두께)
    -->
    <!-- meshdir=assets (go2.xml) 기준 파일명만 지정 -->
    <hfield name="climb_ramp" file="ramp_hfield.png"
            nrow="4" ncol="128" size="1.6 1.0 0.55 0.01"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 중심 x=2.3 → 경사 구간 x=0.7 ~ 3.9, 시작 높이 0 -->
    <geom name="approach_ramp" type="hfield" hfield="climb_ramp"
          pos="2.3 0 0"
          material="ramp_mat"
          rgba="0.82 0.86 0.90 1"
          friction="1.6 0.1 0.02"
          condim="3"/>

    <!-- 경사 끝 높이(0.55)부터 계단 -->
    <geom name="stair_1" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.05 0 0.575"/>
    <geom name="stair_2" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.30 0 0.625"/>
    <geom name="stair_3" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.55 0 0.675"/>
    <geom name="stair_4" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.14 1.0 0.025" pos="4.80 0 0.725"/>
    <geom name="stair_top" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.35 1.0 0.025" pos="5.20 0 0.775"/>
  </worldbody>
</mujoco>
