<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <statistic center="2.5 0 0.15" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="ramp_mat" rgba="0.82 0.86 0.90 1"/>
    <material name="stair_mat" rgba="0.70 0.74 0.80 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      매립형 완만 경사 (~4°)
      - 두꺼운 박스를 살짝 기울인 뒤, 앞쪽 수직면은 땅 아래로 묻음
      - 위 면만 지면(z=0)에서 시작 → 시작부 메시 깨짐/턱/틈 없음
      - 폭을 넓혀(y half=1.6) 옆으로 빠지기 어렵게
    -->
    <geom name="approach_ramp" type="box"
          size="2.5 1.6 0.25"
          pos="3.21135 0 -0.075"
          quat="0.999391 0 -0.0348995 0"
          material="ramp_mat"
          friction="1.8 0.12 0.02"
          condim="3"/>

    <!-- 경사 끝(~0.35 m)부터 계단 -->
    <geom name="stair_1" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.16 1.6 0.02" pos="5.85 0 0.37"/>
    <geom name="stair_2" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.16 1.6 0.02" pos="6.15 0 0.41"/>
    <geom name="stair_3" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.16 1.6 0.02" pos="6.45 0 0.45"/>
    <geom name="stair_4" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.16 1.6 0.02" pos="6.75 0 0.49"/>
    <geom name="stair_top" type="box" material="stair_mat" friction="1.3 0.08 0.02"
          size="0.40 1.6 0.02" pos="7.20 0 0.53"/>
  </worldbody>
</mujoco>
